# C4 Architecture Diagram in D2

# Styles
person: {
  shape: person
  style: {
    fill: #E1F5FE
    stroke: #01579B
    stroke-width: 2
  }
}

system: {
  shape: rectangle
  style: {
    fill: #F3E5F5
    stroke: #4A148C
    stroke-width: 2
  }
}

container: {
  shape: rectangle
  style: {
    fill: #E8F5E9
    stroke: #1B5E20
    stroke-width: 2
  }
}

component: {
  shape: rectangle
  style: {
    fill: #FFF3E0
    stroke: #E65100
    stroke-width: 2
  }
}

connection: {
  style: {
    stroke: #666666
    stroke-width: 1.5,
  }
}

# Layers
layers: {
  "people": 1,
  "systems": 2,
  "containers": 3,
  "components": 4,
}

# System: flask
system: flask {
  shape: rectangle
  layer: "systems"
  style: system
  label: "flask\nCommand-line tool: flask"
}

# Containers for system
system_containers: {
  shape: rectangle
  layer: "containers"
  style: {
    fill: transparent,
    stroke: #1B5E20,
    stroke-width: 1,
    dash: 5,
  },
  container-1: Python Web App {
    shape: rectangle
    style: container
    near: top-left
    label: "Python Web App\n[Python, WSGI, ASGI]"
  }
  container-2: Python CLI {
    shape: rectangle
    style: container
    near: top-left
    label: "Python CLI\n[Python, Command Line]"
  }
  container-3: CLI Tool {
    shape: rectangle
    style: container
    near: top-left
    label: "CLI Tool\n[Command Line, Terminal]"
  }
  container-4: Static Assets {
    shape: rectangle
    style: container
    near: top-left
    label: "Static Assets\n[CSS, JavaScript, Images, Fonts]"
  }
  container-5: Documentation {
    shape: rectangle
    style: container
    near: top-left
    label: "Documentation\n[Markdown, HTML, Sphinx]"
  }
}

# Connections
user -> container-1: Uses {
  style: connection
}
user -> container-2: Uses {
  style: connection
}
user -> container-3: Uses {
  style: connection
}
user -> container-4: Uses {
  style: connection
}
user -> container-5: Uses {
  style: connection
}

direction: TB