# Batho unified root configuration — v1.2.0
# Copy this file to ./batho.yaml and edit values for your environment.
# All state is persisted in a single SQLite artifact: artifact_<dirname>.batho
schema_version: batho-config.v1

logging:
  level: INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
  json_format: null         # true = JSON logs, false = console logs, null = auto-detect
  quiet: false              # Suppress all non-error output
  file: null                # Optional log file path
  format: "%(message)s"     # Log format string

progress:
  enabled: true             # Master switch for build/patch progress bars
  style: progress           # progress = "[ 45%]" percentage | classic = count-only
  mininterval_s: 0.2        # Bar redraw throttle (seconds)
  show_after_s: 2.0         # Phases finishing faster than this never render a bar
  keepalive_s: 60           # Non-TTY long-phase keep-alive line interval (0 = off)
# Environment overrides (precedence: --no-progress flag > env > this section):
#   BATHO_NO_PROGRESS=1      Disable progress (strict: only 1/true/yes count)
#   TQDM_DISABLE=1           Native tqdm override — WARNING: any non-empty value
#                            disables, including "0". Prefer BATHO_NO_PROGRESS.
#   TQDM_MININTERVAL=5       Slow bar redraws (useful for CI log cleanliness)
# CI pipelines: pipes are auto-detected, but some CI runners allocate pseudo-TTYs
# where isatty() lies — prefer an explicit --no-progress or BATHO_NO_PROGRESS=1.

paths:
  db_path: .batho           # Base SQLite artifact name prefix
  cache_dir: .batho/cache   # Shared cache directory for rules, deps, and AST

indexer:
  max_file_size_kb: 500     # Skip files exceeding this size
  max_indexed_files: 200000 # Hard cap on total files indexed
  max_workers: 0            # 0 = auto (CPU count)
  ignore_patterns: []       # Extra gitignore-style patterns
  ignore_files: null        # null = use built-in defaults
  default_patterns_file: null  # Path to custom patterns YAML (null = built-in)
  fail_on_warning: false
  strict: false             # Treat parse warnings as errors
  strict_hashing: false     # true = force SHA-256 content hash on every tracked file
                            # false (default) = skip hashing when mtime+inode+size match

graph:
  cycle_detection:
    enabled: true           # Detect import/inheritance cycles
    fatal: false            # Fail build on cycles when true
  orphan_pruning:
    enabled: true           # Remove nodes with no edges
    keep_entry_points: true # Preserve ENTRY_POINT entities
    keep_exports: true      # Preserve exported symbols when detected

flags:
  fail_on_warning: false
  strict: false
  audit_log_enabled: true   # Enable patch audit trail in run_artifacts

# MCP server tool exposure
mcp:
  enabled: true
  tools:
    # Tools not registered on the MCP app (disappear from tools/list).
    # Default: expensive administrative tools are CLI-only — the agent
    # detects missing/stale artifacts and instructs the user to run them
    # in the terminal, matching the Sourcegraph/Cursor/CodeGraph pattern.
    # Set to [] to expose all 20 tools to the agent.
    disabled: [batho_build, batho_export, batho_load, batho_gc]
    # Optional allowlist — if set, ONLY these tools are registered
    # (disabled is ignored). null = no allowlist filtering.
    # Example: [list_repos, graph_overview, graph_query, get_entity, search_entities]
    enabled: null
  # Toolsets — named tool groups for hosts with tool-count degradation
  # thresholds. Only consulted when tools.disabled / tools.enabled above
  # are both unset (explicit lists win). true = enable the group,
  # false = disable it. Unlisted groups keep their secure-by-default
  # behavior (admin build/export/load/gc disabled; everything else on).
  # Groups:
  #   retrieval:    graph_overview, graph_query, get_entity, trace_path,
  #                 get_file_graph, file_connectivity, search_entities, get_delta
  #   diagnostics:  batho_status, batho_list_runs, batho_diff
  #   registry:     list_repos, add_repo, remove_repo
  #   admin:        batho_build, batho_patch, batho_export, batho_gc,
  #                 batho_fix, batho_load
  # Example — expose everything including Tier-3 admin tools:
  # toolsets: {admin: true}
  # Example — minimal retrieval-only surface:
  # toolsets: {retrieval: true, diagnostics: false, registry: false, admin: false}
  toolsets: null

# Consolidated Dependency Extraction Utility (CDEU)
dependency:
  enabled: true             # Enable stdlib and third-party dependency indexing
  introspection:
    enabled: true           # Introspect installed packages (Python venv, etc.)
    mode: shallow           # shallow (exports only) | deep (recursive)
    venv_auto_detect: true  # Look for .venv in root automatically
    timeout_seconds: 5      # Subprocess timeout for introspecting one package
    # true = attempt every declared dependency (subject to the env-skip
    # policy and no-ecosystem classification); false = only packages in
    # the bundled popular-packages DB. Gate drops are reported as
    # gate_dropped in the dependency_index_complete build log.
    full_scan: false
    popular_packages_db_path: null # null = use bundled DB
    # Skip-when-env-missing policy: when a dep's environment (venv,
    # node_modules, vendor/, user package store) cannot be found, skip it —
    # no fallback {name: [name]} stubs, no cache pollution. false restores
    # legacy best-effort behavior.
    skip_missing_env: true
    # Per-manager overrides, e.g. {gem: false} disables gem introspection.
    # Keys are manager names ("pip", "npm", "cargo", "go", "maven", "gradle",
    # "gem", "composer", "nuget", "pub", "julia", "cran", "cabal", "spm",
    # "zigmod", "rebar3", "opam", "luarocks", "cpan"); unknown keys warn.
    managers: null
  stdlib:
    enabled: true           # Index built-in language standard libraries
    languages: null         # null = auto-detect from project manifests (avoids
                            # cross-language collisions like yaml->ruby).
                            # Or set an explicit list, e.g.:
                            # ["python", "javascript", "go", "rust"]
    # Introspection now supports npm, Cargo, Go modules, and Maven artifacts
    # in addition to Python packages.
  cache:
    enabled: true           # Persist indexed symbols across runs
    ttl_days: 90
  max_deps_per_manifest: 500

# Multi-repo / monorepo workspace scoping (optional — omit entirely for
# single-package repos). Each discovered manifest dir maps to a package
# identity; these keys restrict which manifests are read.
workspace:
  # Which manifest dirs govern dependencies. null = every discovered manifest.
  # List form is an allowlist of repo-relative dir prefixes; dict form supports
  # allow + deny (deny wins). E.g. keep a vendored/docs site out of dep
  # introspection:  manifest_dirs: {deny: [docs-site, examples]}
  manifest_dirs: null

# Optional explicit project identity — overrides manifest-derived package
# identity (manager/name/version used in every entity id prefix).
# project:
#   package:
#     manager: pip          # pip | npm | cargo | go | maven | …
#     name: my-project      # required when project.package is set
#     version: 1.0.0

# Memory-aware tuning. Thresholds are RSS values for the current process.
memory:
  warning_threshold_mb: 800.0
  critical_threshold_mb: 1500.0
  rss_flush_threshold_mb: 1000.0  # persist-and-release early, below critical
  max_per_worker_mb: 150.0       # RAM-based worker cap; conservative for Python + tree-sitter

# Fine-grained control over which blobs are written to the SQLite artifact.
# Disable blobs you don't need to reduce artifact size.
artifact_blobs:
  file_artifacts:           # Blobs per file in file_artifacts table
    bsg_agent_view: true    # LLM-optimised structural nodes (lightweight)
    bsg_storage_view: true  # Full-fidelity delta blobs (raw_content, syntax_glue)
    bsg_rel_view: true      # Relationships array
  run_artifacts:            # Blobs per run in run_artifacts table
    context_overview: true  # Language / file category / entity distribution
    telemetry_metrics: true # Duration phases, cache stats, file/entity counts
    structural_metrics: true # Entity type dist, fan-in/fan-out, LOC
    security_audit: false   # BSG interceptor hits (opt-in, off by default)
    artifact_payload: true  # Pre-minified entity+rel summary for LLM injection
    delta_stats: true       # Churn / node diffs (null for initial build runs)

rules:
  enabled: true             # Enable BSG rule plugins during indexing
  auto_load_all_plugins: true
  builtin_plugins:
    - bsg_core
    - bsg_silent_failure_catcher
    - bsg_dependency_blast_radius
    - bsg_resource_leak_preventer
    - bsg_nplus1_query_catcher
    - bsg_iac_drift_sentinel
    - bsg_schema_migration_enforcer
    - bsg_api_contract_guardian
    - bsg_hardcoded_secret_catcher
    - bsg_auth_boundary_shield
  disabled_rules: []
  custom_rules_path: null   # Path to YAML file with custom rules
  custom_rules_inline: []   # Inline rules (same schema as file-based)
  strict_validation: false  # Fail on invalid plugin/custom rules
  cache_ttl: 3600           # Rule cache TTL in seconds
  fail_on_rule_error: false

  # Example custom rules:
  # custom_rules_inline:
  #   - name: mark-test-files
  #     file_patterns: ["tests/**", "**/*_test.py"]
  #     metadata:
  #       bsg.category: TEST
  #   - name: payment-cluster
  #     entity_types: ["function", "method"]
  #     name_patterns: ["*payment*", "*invoice*"]
  #     metadata:
  #       bsg.cluster_hint: billing

plugins:
  overrides: {}
  # Example override:
  # overrides:
  #   bsg_graph_foundation:
  #     bsg-category-tests:
  #       severity: warning

bsg:
  parallel:
    enabled: true
    max_workers: 16         # Max parallel BSG workers (1-32)
    chunk_size: 50          # Files per parallel chunk

  cache:
    enabled: true
    max_size_mb: 1024       # In-process BSG cache size limit
    ttl_days: 30            # BSG cache entry TTL

  symbol_resolution:
    enabled: true
    cache_symbols: true

  parsing:
    error_recovery: true    # Continue past parse errors
    skip_comments: false

  bidirectional:
    enabled: true           # Enable bidirectional BSG (lossless reconstruction)
    include_gaps: true      # Emit SYNTAX_GLUE entities for 100% byte coverage
    verify_integrity: false # Enforce hash verification during reconstruction
    storage_view: false     # Persist raw_content in storage view (larger artifact)

# Extraction module — AST caching and parser configuration
extraction:
  cache:
    enabled: true           # Persist parsed AST to disk for cross-session reuse
    ttl_days: 30             # Days before cached AST entries expire
    max_entries: 5000        # Maximum cached files (oldest evicted first)
  # Opt-in entity extraction flags (default: false to avoid entity-count inflation)
  extract_parameters: false       # Extract function/method parameters as PARAMETER entities
  extract_type_parameters: false  # Extract generic type parameters (T, K, V) as TYPE_PARAMETER entities

# Community detection via Leiden clustering
community_detection:
  enabled: true             # Disable to skip Leiden entirely
  skip_threshold: 200000   # Skip community detection above this entity count
  sample_threshold: 100000  # Sample whole files down to this count before Leiden
