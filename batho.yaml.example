# Batho unified root configuration
# Copy this file to ./batho.yaml and edit values for your environment.

logging:
  level: INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
  json_format: null         # true = JSON logs, false = console logs, null = auto

paths:
  ctn_dir: .ctn             # Output/index directory

indexer:
  max_file_size_kb: 500
  max_indexed_files: 200000
  max_workers: 0            # 0 = auto
  max_files: null           # Optional hard cap for files processed
  ignore_patterns: []       # Extra glob patterns
  ignore_files: null        # null uses defaults; or provide list of ignore filenames
  metrics_output: .ctn/metrics.json
  fail_on_warning: false
  strict: false

patch:
  timeout_seconds: 300
  max_changes: 10000
  audit_log_path: .ctn/patch_audit.log
  history_days: 90
  max_count: 1000
  cleanup_on_startup: false

flags:
  fail_on_warning: false
  strict: false
  audit_log_enabled: true

rules:
  enabled: false            # Enable BSG rule plugins during indexing
  builtin_plugins:
    - bsg_core
    - bsg_silent_failure_catcher
    - bsg_dependency_blast_radius
    - bsg_resource_leak_preventer
    - bsg_nplus1_query_catcher
    - bsg_iac_drift_sentinel
    - bsg_schema_migration_enforcer
    - bsg_api_contract_guardian
    - bsg_hardcoded_secret_catcher
    - bsg_auth_boundary_shield
  disabled_rules: []
  custom_rules_path: null   # Optional path to YAML file with custom rules
  custom_rules_inline: []   # Optional inline rules (same schema as file-based rules)
  strict_validation: false  # True = fail on invalid plugin/custom rules
  cache_ttl: 3600
  fail_on_rule_error: false

  # Example custom rules
  # custom_rules_inline:
  #   - name: mark-test-files
  #     file_patterns: ["tests/**", "**/*_test.py"]
  #     metadata:
  #       bsg.category: TEST
  #   - name: payment-cluster
  #     entity_types: ["function", "method"]
  #     name_patterns: ["*payment*", "*invoice*"]
  #     metadata:
  #       bsg.cluster_hint: billing

plugins:
  overrides: {}
  # Example override:
  # overrides:
  #   bsg_graph_foundation:
  #     bsg-category-tests:
  #       severity: warning
  #       actions:
  #         metadata:
  #           bsg.category: TEST

schemas:
  graph: graph.v1
  bsg: bsg.v1
  snapshot: snapshot.v1
  index_metadata: index-metadata.v1
  file_cache: file-cache.v1

webhook:
  enabled: false            # Safer default; set true to activate webhook processing

  server:
    host: 0.0.0.0
    port: 8080
    workers: 4
    endpoint: /webhook
    health_endpoint: /health

  # REQUIRED when webhook.enabled=true
  # Example GitHub:
  # repository:
  #   name: your-org/your-repo
  #   platform: github
  #   secret: ${WEBHOOK_SECRET}
  #   branches: [main, develop]
  # Example GitLab:
  # repository:
  #   name: your-group/your-repo
  #   platform: gitlab
  #   secret: ${WEBHOOK_SECRET}
  #   branches: [main]
  repository:
    name: your-org/your-repo
    platform: github        # github | gitlab
    secret: ${WEBHOOK_SECRET}
    github_secret: null     # Optional provider-specific override
    gitlab_token: null      # Optional provider-specific override
    branches: [main, develop]
    path: null              # Optional repo path override
    allowed_ips: []         # Optional repository-level allowlist (IPs/CIDRs)
    rate_limit_per_hour: 100

  processing:
    queue_backend: celery   # celery | sync
    celery_broker_url: memory://
    celery_result_backend: cache+memory://
    task_always_eager: true
    task_store_eager_result: false
    batch_size: 100
    timeout_seconds: 300
    retry_attempts: 3

  rate_limit:
    requests_per_hour: 100  # Global fallback limit
    burst_size: 10

  logging:
    level: INFO
    file: null              # e.g. .ctn/webhook.log

  github_secret: null       # Optional top-level secret override
  gitlab_token: null        # Optional top-level token override
  allowed_ips: []           # Optional global allowlist (IPs/CIDRs)

cloud_sync:
  enabled: false
  endpoint: https://sync.batho.dev/v1
  api_key: ${BATHO_CLOUD_API_KEY}
  organization_id: ""
  project_id: ""           # Defaults to repo folder name when empty
  timeout_seconds: 300
  max_retries: 3
  batch_size: 10

bsg:
  parallel:
    enabled: true
    max_workers: 16
    chunk_size: 50

  ignore:
    enabled: true
    file: .bathoignore

  cache:
    enabled: true
    path: ~/.batho/ast_cache.db
    max_size_mb: 1024
    ttl_days: 30

  incremental:
    enabled: true
    fallback_to_full: true
    auto_detect_git: true

  symbol_resolution:
    enabled: true
    fuzzy_matching: false
    cache_symbols: true

  serialization:
    method: legacy          # legacy | streaming
    compression: false
    batch_size: 1000

  parsing:
    error_recovery: true
    partial_parsing: false
    max_file_size_mb: 10
    skip_comments: false

  query:
    enabled: true
    index_on_write: true
    cache_enabled: true
    cache_size: 256
    default_limit: 200
    query_timeout_ms: 5000

  storage:
    enabled: true
    backend: sqlite          # sqlite
    registry_path: .ctn/artifact_registry.db
    content_scope: durable   # durable | all
    strict_compatibility: true
    cloud_sync_ready: true
    track_content_ids: true
    mmap_enabled: false
    mmap_min_size_mb: 8
    retention:
      enabled: true
      snapshot_ttl_days: 90
      patch_ttl_days: 90
      metrics_ttl_days: 30
      context_ttl_days: 90
      max_snapshots: 500
      max_patches: 5000
