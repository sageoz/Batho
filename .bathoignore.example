# Batho Ignore File
# This file uses glob patterns to exclude files/directories from BSG indexing.
# Patterns are merged with global ignore patterns.
# Format: one pattern per line, shell-style globs (same as .gitignore)

# Build artifacts and dependencies
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/build/
**/dist/
**/*.egg-info/
**/.eggs/
**/node_modules/
**/vendor/
**/.venv/
**/venv/
**/ENV/

# IDE and editor files
**/.vscode/
**/.idea/
**/.DS_Store
**/*.swp
**/*.swo
**/*~
**/.project
**/.settings/

# Test and coverage artifacts
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.mypy_cache/
**/coverage.xml
**/*.cover

# Documentation and generated files
**/_build/
**/site/
**/.doctrees/
**/*.md~

# Temporary and cache files
**/tmp/
**/temp/
**/*.tmp
**/*.bak
**/*.log
**/*.cache

# Large binary files
**/*.zip
**/*.tar
**/*.tar.gz
**/*.rar
**/*.7z
**/*.iso
**/*.dmg
**/*.img
**/*.bin

# Database files
**/*.db
**/*.sqlite
**/*.sqlite3

# Environment files
**/.env
**/.env.local
**/.env.*.local

# OS-specific files
**/Thumbs.db
**/Desktop.ini
**/.Spotlight-V100
**/.Trashes

# Version control (usually handled by .gitignore, but for safety)
**/.git/
**/.hg/
**/.svn/

# CI/CD
**/.github/workflows/*.log
**/.gitlab-ci.yml
**/Jenkinsfile

# Large data files
**/data/
**/datasets/
**/*.csv
**/*.xlsx
**/*.xls
**/*.parquet
**/assets/images/
**/assets/videos/
**/assets/audio/

# Lock files (package managers)
**/poetry.lock
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
**/uv.lock

# Example/skeleton files
**/example/
**/examples/
**/demo/
**/samples/
