{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageoz.org/batho/schemas/bsg-plugin-schema-v1.json",
  "title": "Batho BSG Plugin Schema v1",
  "description": "Unified BSG plugin schema. Includes plugin dependencies, numeric severity scoring, conditional actions (when), regex matchers, cross-entity metadata joins, and extended control/data-flow edges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "name",
    "version",
    "enabled",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bsg-plugin.v1"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "description": "Plugin IDs this plugin depends on. Loader enforces topological order and warns if any dependency is missing.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "name",
        "description",
        "severity",
        "priority",
        "enabled",
        "matchers",
        "actions"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "block"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Fine-grained numeric severity score (0–1000) independent of the severity bucket."
        },
        "priority": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Free-form classification tags used by the catalog generator and CLI filters."
        },
        "matchers": {
          "$ref": "#/$defs/matchers"
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "matchers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "name_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "file_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "content_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Patterns to match in file content (e.g., dependency names in package.json)"
        },
        "regex_patterns": {
          "type": "array",
          "items": {"$ref": "#/$defs/regexMatcher"},
          "description": "Compiled regex patterns applied to entity name, file path, signature, or metadata fields."
        },
        "usn_tags_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadataCondition"
          }
        },
        "ast_edges": {
          "$ref": "#/$defs/astEdgeGroup"
        }
      }
    },
    "regexMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Python regex pattern; compiled once at plugin load time."
        },
        "target": {
          "type": "string",
          "enum": ["name", "file_path", "signature", "metadata"],
          "default": "name",
          "description": "Field the regex is evaluated against."
        },
        "metadata_key": {
          "type": "string",
          "minLength": 1,
          "description": "When target=metadata, the metadata key to stringify and match."
        },
        "case_insensitive": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "metadataCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Metadata key to check"
        },
        "operator": {
          "type": "string",
          "enum": [
            "exists",
            "length_gt",
            "length_lt",
            "contains_any",
            "contains_all",
            "in",
            "not_in",
            "eq",
            "neq",
            "regex_match"
          ],
          "description": "Comparison operator"
        },
        "value": {
          "description": "Value to compare against (type depends on operator)"
        }
      }
    },
    "astEdgeGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/astEdgeMatcher"
          }
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/astEdgeMatcher"
          }
        }
      }
    },
    "astEdgeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge"],
      "properties": {
        "edge": {
          "type": "string",
          "enum": [
            "IMPORTS",
            "CALLS",
            "USES",
            "INHERITS",
            "INHERITS_FROM",
            "IMPLEMENTS",
            "WRAPPED_BY",
            "DEPENDS_ON_API",
            "REFERENCED_IN",
            "CLEANED_BY",
            "CONTAINED_WITHIN",
            "CONTROLS",
            "CALLS_ASYNC",
            "RAISES",
            "CATCHES",
            "READS",
            "WRITES",
            "MUTATES"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["outbound", "inbound", "either"],
          "default": "either"
        },
        "target_entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_usn_tags_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_name_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_metadata_equals": {
          "type": "object",
          "description": "Cross-entity metadata join: target entity must have these metadata key/value pairs.",
          "additionalProperties": true
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional condition gate applied to actions. If provided, actions only fire when the condition holds.",
      "properties": {
        "all": {
          "type": "array",
          "items": {"$ref": "#/$defs/metadataCondition"}
        },
        "any": {
          "type": "array",
          "items": {"$ref": "#/$defs/metadataCondition"}
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {"$ref": "#/$defs/when"},
        "metadata": {
          "type": "object"
        },
        "add_usn_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derive_scope_tier": {
          "type": "boolean"
        },
        "derive_service_tag": {
          "type": "boolean"
        },
        "truncate_docstring": {
          "type": "boolean",
          "description": "Truncate docstrings to max_docstring_length"
        },
        "max_docstring_length": {
          "type": "integer",
          "minimum": 1,
          "default": 150,
          "description": "Maximum docstring length before truncation"
        },
        "normalize_entry_point": {
          "type": "boolean",
          "description": "Normalize entry point names to __main__"
        },
        "detect_language": {
          "type": "object",
          "description": "Detect programming language from file patterns and content",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "detect_framework": {
          "type": "object",
          "description": "Detect framework from content patterns",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "framework": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "detect_package_manager": {
          "type": "object",
          "description": "Detect package manager from file patterns",
          "properties": {
            "package_manager": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "detect_infra": {
          "type": "object",
          "description": "Detect infrastructure tools (Docker, K8s, etc.)",
          "properties": {
            "infra_type": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        "assign_category": {
          "type": "object",
          "description": "Assign file category (TEST, DOC, CONFIG, INFRA, SOURCE, UNCATEGORIZED)",
          "properties": {
            "category": {
              "type": "string",
              "enum": ["TEST", "DOC", "CONFIG", "INFRA", "SOURCE", "UNCATEGORIZED"]
            },
            "priority": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
