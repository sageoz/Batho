{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batho.dev/schemas/bsg-plugin-schema-v1.json",
  "title": "Batho BSG Plugin Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "name",
    "version",
    "enabled",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bsg-plugin.v1"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "name",
        "description",
        "severity",
        "priority",
        "enabled",
        "matchers",
        "actions"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "block"]
        },
        "priority": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "matchers": {
          "$ref": "#/$defs/matchers"
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "matchers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "name_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "file_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usn_tags_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadataCondition"
          }
        },
        "ast_edges": {
          "$ref": "#/$defs/astEdgeGroup"
        }
      }
    },
    "metadataCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Metadata key to check"
        },
        "operator": {
          "type": "string",
          "enum": ["exists", "length_gt", "contains_any", "in", "eq"],
          "description": "Comparison operator"
        },
        "value": {
          "description": "Value to compare against (type depends on operator)"
        }
      }
    },
    "astEdgeGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/astEdgeMatcher"
          }
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/astEdgeMatcher"
          }
        }
      }
    },
    "astEdgeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge"],
      "properties": {
        "edge": {
          "type": "string",
          "enum": [
            "IMPORTS",
            "CALLS",
            "USES",
            "INHERITS",
            "INHERITS_FROM",
            "IMPLEMENTS",
            "WRAPPED_BY",
            "DEPENDS_ON_API",
            "REFERENCED_IN",
            "CLEANED_BY",
            "CONTAINED_WITHIN"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["outbound", "inbound", "either"],
          "default": "either"
        },
        "target_entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_usn_tags_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_name_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object"
        },
        "add_usn_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derive_scope_tier": {
          "type": "boolean"
        },
        "derive_service_tag": {
          "type": "boolean"
        },
        "truncate_docstring": {
          "type": "boolean",
          "description": "Truncate docstrings to max_docstring_length"
        },
        "max_docstring_length": {
          "type": "integer",
          "minimum": 1,
          "default": 150,
          "description": "Maximum docstring length before truncation"
        },
        "normalize_entry_point": {
          "type": "boolean",
          "description": "Normalize entry point names to __main__"
        }
      }
    }
  }
}
