        "%APPDATA%\\devin\\mcp_config.json"
      ],
      "key": "mcpServers",
      "format": "json",
      "entry_shape": "command_args",
      "notes": "Legacy (~/.codeium/windsurf) and post-Cognition Cortex (~/.config/devin) paths are both live depending on build — write to every path whose parent dir exists."
    },
