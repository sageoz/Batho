      "configs": [
        "~/.cursor/mcp.json"
      ],
      "windows_configs": [
        "%USERPROFILE%\\.cursor\\mcp.json"
      ],
      "key": "mcpServers",
      "format": "json",
      "entry_shape": "command_args"
    },
