{
  "_schema": {
    "version": 2,
    "description": "Canonical per-agent table for the Batho installers. Consumed by install.sh (embedded rendering), install.ps1 (ConvertFrom-Json), skills/batho-setup/scripts/install_pack.py, and batho/install/mcp_config.py (mcp_agents only). Skill strategy: always write canonical <scope>/.agents/skills; for agents with reads_agents_dir=false also mirror into their native dirs when detected (marker exists) or forced via --agent/--all. MCP strategy (mcp_agents, v2): register the stdio server `batho mcp` in each detected client's config file (merge-not-clobber, atomic write).",
    "fields": {
      "reads_agents_dir": "agent discovers <scope>/.agents/skills natively — no mirror required",
      "detect": "markers whose existence means the agent is installed (global dirs under $HOME; project dirs relative to project root)",
      "project_dirs": "native skill dirs relative to project root (written when detected/forced; informational when reads_agents_dir=true)",
      "global_dirs": "native skill dirs under $HOME / %USERPROFILE% (posix form; windows override where noted)",
      "windows_global_dirs": "Windows-specific global paths (env-var form; substituted at runtime)",
      "mcp_agents": "v2 section: clients that support MCP server registration. Per entry: detect (client-installed markers), configs (posix config-file paths; a path is written only when its parent dir exists), windows_configs (Windows overrides), key (top-level key holding the server map — VS Code uses 'servers', most others 'mcpServers'), format (json | toml), entry_shape (command_args | command_array — OpenCode nests command as a list)"
    }
  },
  "pack_skills": [
    "batho",
    "batho-setup",
    "batho-specs",
    "batho-execute",
    "batho-review",
    "batho-calibrate"
  ],
  "canonical": {
    "project": ".agents/skills",
    "global_posix": "~/.agents/skills",
    "global_windows": "%USERPROFILE%\\.agents\\skills"
