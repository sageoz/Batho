  "mcp_agents": {
    "claude-desktop": {
      "display": "Claude Desktop",
      "detect": {
        "global_dirs": [
          "~/Library/Application Support/Claude",
          "%APPDATA%/Claude"
        ],
        "bins": []
      },
      "configs": [
        "~/Library/Application Support/Claude/claude_desktop_config.json"
      ],
      "windows_configs": [
        "%APPDATA%\\Claude\\claude_desktop_config.json"
      ],
      "key": "mcpServers",
      "format": "json",
      "entry_shape": "command_args",
      "notes": "No CLI — direct file write; full app restart required; absolute command paths mandatory (no shell PATH inheritance)."
    },
    "claude-code": {
      "display": "Claude Code",
      "detect": {
        "global_dirs": [
          "~/.claude",
          "~/.claude.json"
        ],
        "bins": [
          "claude"
        ]
      },
      "configs": [
        "~/.claude.json"
      ],
      "key": "mcpServers",
      "format": "json",
      "entry_shape": "command_args",
      "notes": "User scope = top-level mcpServers in ~/.claude.json (matches `claude mcp add --scope user`). File also holds Claude Code session state — merge must preserve unrelated keys."
    },
    "cursor": {
      "display": "Cursor",
      "detect": {
        "global_dirs": [
          "~/.cursor"
        ],
        "bins": [
